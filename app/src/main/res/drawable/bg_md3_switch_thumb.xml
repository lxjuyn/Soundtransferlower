<?xml version="1.0" encoding="utf-8"?>
<!-- M3 Switch 滑块：24dp 圆形，inset 4dp 与 32dp 轨道同心；选中=on-primary，未选中=outline -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="4dp"
    android:insetTop="4dp"
    android:insetRight="4dp"
    android:insetBottom="4dp">
    <selector>
        <item android:state_checked="true">
            <shape android:shape="oval">
                <solid android:color="@color/md3_on_primary" />
                <size
                    android:width="24dp"
                    android:height="24dp" />
            </shape>
        </item>
        <item>
            <shape android:shape="oval">
                <solid android:color="@color/md3_outline" />
                <size
                    android:width="24dp"
                    android:height="24dp" />
            </shape>
        </item>
    </selector>
</inset>
