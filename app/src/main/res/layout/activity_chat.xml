<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/md3Surface">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/md3Surface"
        android:theme="?attr/actionBarTheme">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_md3_arrow_back"
            android:tag="md3-icon-on-surface"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />

        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="设备名称"
            android:textColor="?attr/md3OnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_md3_more_vert"
            android:tag="md3-icon-on-surface"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="菜单" />
    </androidx.appcompat.widget.Toolbar>

    <!-- 消息列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:background="?attr/md3Surface"
        android:scrollbars="vertical" />

    <!-- 底部输入区域：圆角卡片栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:tag="md3-card">
        <ImageButton
            android:id="@+id/btnVoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_voice"
            android:tag="md3-btn-tonal"
            android:padding="8dp" />
        <!-- 输入框 -->
        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:tag="md3-input"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:textColor="?attr/md3OnSurface"
            android:textColorHint="?attr/md3OnSurfaceVariant"
            android:hint="输入消息"
            android:inputType="textMultiLine"
            android:maxLines="5"
            android:minLines="1" />

        <!-- 发送按钮 -->
        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="md3-btn-filled"
            android:text="发送"
             />

        <!-- 更多按钮 -->
        <Button
            android:id="@+id/btnMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:tag="md3-btn-tonal"
            android:text="更多"
           />
    </LinearLayout>
</LinearLayout>