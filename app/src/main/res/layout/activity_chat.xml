<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/md3Surface">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/md3Surface"
        android:theme="?attr/actionBarTheme">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_md3_arrow_back"
            android:tag="md3-icon-on-surface"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />

        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="设备名称"
            android:textColor="?attr/md3OnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_md3_more_vert"
            android:tag="md3-icon-on-surface"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="菜单" />
    </androidx.appcompat.widget.Toolbar>

    <!-- 消息列表 + 空状态视图 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:background="?attr/md3Surface"
            android:scrollbars="vertical" />

        <!-- 空状态（消息列表为空时显示） -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:srcCompat="@drawable/ic_md3_chat"
                android:tag="md3-icon-outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="还没有消息"
                android:textColor="?attr/md3OnSurface"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="发送一条消息开始对话"
                android:textColor="?attr/md3OnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部输入区域：圆角卡片栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:tag="md3-card">
        <ImageButton
            android:id="@+id/btnVoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_voice"
            android:tag="md3-btn-tonal"
            android:padding="8dp" />
        <!-- 输入框 -->
        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:tag="md3-input"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:textColor="?attr/md3OnSurface"
            android:textColorHint="?attr/md3OnSurfaceVariant"
            android:hint="输入消息"
            android:inputType="textMultiLine"
            android:maxLines="5"
            android:minLines="1" />

        <!-- 发送按钮（图标化） -->
        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:tag="md3-btn-filled"
            app:srcCompat="@drawable/ic_md3_send"
            android:contentDescription="发送" />

        <!-- 更多按钮（图标化） -->
        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:tag="md3-btn-tonal"
            app:srcCompat="@drawable/ic_md3_more_vert"
            android:contentDescription="更多" />
    </LinearLayout>
</LinearLayout>